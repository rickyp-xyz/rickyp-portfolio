---
import projects from '../data/projects.json';
import Layout from '../layouts/Layout.astro';

import { site } from "../config/site";

const title = `Projects ~ ${site.name}`
const description =
    `Explore ${site.name}'s projects, experiments, and open-source work across web development, software, and technology.`;

const canonical = `${site.url}/projects`;

interface Project {
    id: number;
    title: string;

    description: {
        short: string;
        long: string;
    };

    source: string;
    license?: string;

    context?: {
        type: string;
        name: string;
    };

    links: {
        demo?: string;
        live?: string;
        repo?: string;
        docs?: string;
    };

    media: {
        cover: string;
    };

    technology: string[];
    tools: string[];
}
---

<Layout
    title={title}
    description={description}
    canonical={canonical}
    ogType="website"
>
    <div class="projects-page">
        <div class="projects-shell">

            <header class="projects-header">
                <h1>Projects</h1>
                <p>
                    A collection of things I've built, experimented with,
                    and brought to life.
                </p>
            </header>

            <ul class="projects-grid">
                {projects.map((project: Project) => (
                    <li class="project-card">

                        <div class="card-glow"></div>

                        <div class="project-cover">
                            <img
                                src={project.media.cover}
                                alt={`${project.title} cover`}
                                loading="lazy"
                            />

                            <div class="cover-overlay"></div>

                            {project.context?.type && (
                                <span class="project-type">
                                    {project.context.type}
                                </span>
                            )}
                        </div>

                        <div class="project-content">

                            <div class="project-heading">
                                <h2>{project.title}</h2>
                            </div>

                            <p class="project-short">
                                {project.description.short}
                            </p>

                            <p class="project-long">
                                {project.description.long}
                            </p>

                            <div class="project-meta">

                                <div class="meta-group">
                                    <span class="meta-label">
                                        Source
                                    </span>

                                    <div class="tags">
                                        <span class="tag">
                                            {project.source}
                                        </span>

                                        {project.license && (
                                            <span class="tag">
                                                {project.license}
                                            </span>
                                        )}
                                    </div>
                                </div>

                                {project.context && (
                                    <div class="meta-group">
                                        <span class="meta-label">
                                            Context
                                        </span>

                                        <div class="tags">
                                            <span class="tag">
                                                {project.context.type}
                                            </span>

                                            <span class="tag">
                                                {project.context.name}
                                            </span>
                                        </div>
                                    </div>
                                )}

                                <div class="meta-group">
                                    <span class="meta-label">
                                        Technology
                                    </span>

                                    <div class="tags">
                                        {project.technology.map((technology) => (
                                            <span class="tag">
                                                {technology}
                                            </span>
                                        ))}
                                    </div>
                                </div>

                                <div class="meta-group">
                                    <span class="meta-label">
                                        Tools
                                    </span>

                                    <div class="tags">
                                        {project.tools.map((tool) => (
                                            <span class="tag">
                                                {tool}
                                            </span>
                                        ))}
                                    </div>
                                </div>

                            </div>

                            <div class="project-links">

                                {project.links.demo && (
                                    <a
                                        class="project-link project-link-primary"
                                        href={project.links.demo}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        <span>View demo</span>
                                        <span class="arrow">↗</span>
                                    </a>
                                )}

                                {project.links.live && (
                                    <a
                                        class="project-link project-link-primary"
                                        href={project.links.live}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        <span>View project</span>
                                        <span class="arrow">↗</span>
                                    </a>
                                )}

                                {project.links.docs && (
                                    <a
                                        class="project-link"
                                        href={project.links.docs}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        <span>Documentation</span>
                                        <span class="arrow">↗</span>
                                    </a>
                                )}

                                {project.links.repo && (
                                    <a
                                        class="project-link"
                                        href={project.links.repo}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                    >
                                        <span>Repository</span>
                                        <span class="arrow">↗</span>
                                    </a>
                                )}

                            </div>

                        </div>
                    </li>
                ))}
            </ul>

        </div>
    </div>

</Layout>

<style>
    /* =========================================================
       PAGE
       ========================================================= */

    .projects-page {
        position: relative;
        min-height: 100vh;
        padding: 8rem 2rem 6rem;
        z-index: 1;
    }

    .projects-shell {
        width: min(1400px, 100%);
        margin: 0 auto;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .projects-header {
        width: min(760px, 100%);
        margin: 0 auto 5rem;
        text-align: center;
    }

    .footer-eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        color: var(--color-cyan);
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.22em;
        text-transform: uppercase;
    }

    .projects-header h1 {
        margin-bottom: 1.25rem;
        font-size: clamp(3rem, 7vw, 6.5rem);
        font-weight: 400;
        line-height: 0.95;
        letter-spacing: -0.055em;
        color: rgba(255, 255, 255, 0.96);
        text-shadow:
            0 0 40px rgba(255, 255, 255, 0.08),
            0 0 80px rgba(51, 237, 229, 0.06);
    }

    .projects-header p {
        max-width: 580px;
        margin: 0 auto;
        color: rgba(255, 255, 255, 0.58);
        font-size: 1rem;
        font-weight: 300;
        line-height: 1.7;
    }


    /* =========================================================
       PROJECT GRID
       ========================================================= */

    .projects-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 2rem;
        list-style: none;
    }


    /* =========================================================
       GLASS CARD
       ========================================================= */

    .project-card {
        position: relative;
        isolation: isolate;
        overflow: hidden;

        min-width: 0;

        border: 1px solid rgba(255, 255, 255, 0.13);
        border-radius: 28px;

        background:
            linear-gradient(
                135deg,
                rgba(255, 255, 255, 0.115),
                rgba(255, 255, 255, 0.035) 45%,
                rgba(255, 255, 255, 0.018)
            );

        box-shadow:
            0 25px 80px rgba(0, 0, 0, 0.35),
            inset 0 1px 0 rgba(255, 255, 255, 0.18),
            inset 0 -1px 0 rgba(255, 255, 255, 0.035);

        backdrop-filter: blur(22px) saturate(135%);
        -webkit-backdrop-filter: blur(22px) saturate(135%);

        transition:
            transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1),
            border-color 500ms ease,
            box-shadow 500ms ease;
    }

    .project-card::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;

        background:
            linear-gradient(
                115deg,
                rgba(255, 255, 255, 0.12) 0%,
                transparent 18%,
                transparent 65%,
                rgba(51, 237, 229, 0.055) 100%
            );

        opacity: 0.8;
    }

    .card-glow {
        position: absolute;
        z-index: -1;

        width: 240px;
        height: 240px;

        top: -120px;
        right: -100px;

        border-radius: 50%;

        background: rgba(51, 237, 229, 0.09);
        filter: blur(70px);

        pointer-events: none;
        transition:
            transform 700ms ease,
            opacity 500ms ease;
    }

    .project-card:hover {
        transform: translateY(-8px);

        border-color: rgba(255, 255, 255, 0.24);

        box-shadow:
            0 35px 100px rgba(0, 0, 0, 0.45),
            0 0 60px rgba(51, 237, 229, 0.045),
            inset 0 1px 0 rgba(255, 255, 255, 0.25),
            inset 0 -1px 0 rgba(255, 255, 255, 0.05);
    }

    .project-card:hover .card-glow {
        transform: scale(1.5);
        opacity: 1.5;
    }


    /* =========================================================
       PROJECT COVER
       ========================================================= */

    .project-cover {
        position: relative;
        overflow: hidden;

        height: 280px;

        border-bottom: 1px solid rgba(255, 255, 255, 0.1);

        background: rgba(0, 0, 0, 0.2);
    }

    .project-cover img {
        display: block;

        width: 100%;
        height: 100%;

        object-fit: cover;
        object-position: center center;
        
        opacity: 0.76;

        filter:
            saturate(0.85)
            contrast(0.95);

        transform: scale(1.01);

        transition:
            transform 800ms cubic-bezier(0.2, 0.8, 0.2, 1),
            opacity 500ms ease,
            filter 500ms ease;
    }

    .project-card:hover .project-cover img {
        transform: scale(1.055);
        opacity: 0.88;

        filter:
            saturate(1)
            contrast(1);
    }

    .cover-overlay {
        position: absolute;
        inset: 0;

        background:
            linear-gradient(
                180deg,
                rgba(10, 10, 10, 0.02) 0%,
                rgba(10, 10, 10, 0.05) 35%,
                rgba(10, 10, 10, 0.72) 100%
            );

        pointer-events: none;
    }

    .cover-overlay::after {
        content: "";
        position: absolute;

        top: -50%;
        left: -30%;

        width: 80%;
        height: 200%;

        transform: rotate(22deg);

        background:
            linear-gradient(
                90deg,
                transparent,
                rgba(255, 255, 255, 0.07),
                transparent
            );

        pointer-events: none;
    }

    .project-type {
        position: absolute;
        left: 1.25rem;
        bottom: 1.25rem;

        padding: 0.45rem 0.75rem;

        border: 1px solid rgba(255, 255, 255, 0.17);
        border-radius: 999px;

        background: rgba(10, 10, 10, 0.28);

        color: rgba(255, 255, 255, 0.82);

        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;

        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);

        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }


    /* =========================================================
       CARD CONTENT
       ========================================================= */

    .project-content {
        padding: 2rem;
    }

    .project-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;

        margin-bottom: 1rem;
    }

    .project-heading h2 {
        min-width: 0;

        color: rgba(255, 255, 255, 0.94);

        font-size: clamp(1.5rem, 2.5vw, 2rem);
        font-weight: 450;
        line-height: 1.15;
        letter-spacing: -0.035em;
    }

    .project-short {
        margin-bottom: 0.75rem;

        color: rgba(255, 255, 255, 0.78);

        font-size: 0.98rem;
        font-weight: 400;
        line-height: 1.55;
    }

    .project-long {
        margin-bottom: 1.75rem;

        color: rgba(255, 255, 255, 0.48);

        font-size: 0.86rem;
        font-weight: 300;
        line-height: 1.7;
    }


    /* =========================================================
       TAGS
       ========================================================= */

    .project-meta {
        display: flex;
        flex-direction: column;
        gap: 1rem;

        margin-bottom: 1.75rem;
    }

    .meta-group {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
    }

    .meta-label {
        flex-shrink: 0;

        width: 88px;
        padding-top: 0.35rem;

        color: rgba(255, 255, 255, 0.3);

        font-size: 0.63rem;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .tag {
        display: inline-flex;
        align-items: center;

        padding: 0.35rem 0.6rem;

        border: 1px solid rgba(255, 255, 255, 0.095);
        border-radius: 7px;

        background: rgba(255, 255, 255, 0.045);

        color: rgba(255, 255, 255, 0.6);

        font-size: 0.68rem;
        font-weight: 400;

        box-shadow:
            inset 0 1px 0 rgba(255, 255, 255, 0.045);

        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }


    /* =========================================================
       PROJECT LINKS
       ========================================================= */

    .project-links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;

        padding-top: 1.5rem;

        border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .project-link {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;

        min-height: 42px;
        padding: 0.65rem 0.9rem;

        border: 1px solid rgba(255, 255, 255, 0.11);
        border-radius: 10px;

        background: rgba(255, 255, 255, 0.035);

        color: rgba(255, 255, 255, 0.65);

        font-size: 0.75rem;
        font-weight: 400;
        text-decoration: none;

        transition:
            background 250ms ease,
            border-color 250ms ease,
            color 250ms ease,
            transform 250ms ease;

        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
    }

    .project-link:hover {
        transform: translateY(-2px);

        border-color: rgba(255, 255, 255, 0.24);

        background: rgba(255, 255, 255, 0.085);

        color: #fff;
    }

    .project-link-primary {
        border-color: rgba(51, 237, 229, 0.2);
        background: rgba(51, 237, 229, 0.07);
        color: rgba(255, 255, 255, 0.86);
    }

    .project-link-primary:hover {
        border-color: rgba(51, 237, 229, 0.42);
        background: rgba(51, 237, 229, 0.12);

        box-shadow:
            0 0 25px rgba(51, 237, 229, 0.08);
    }

    .arrow {
        color: var(--color-cyan);
        font-size: 0.9rem;

        transition: transform 250ms ease;
    }

    .project-link:hover .arrow {
        transform: translate(2px, -2px);
    }

    /* =========================================================
       TABLET
       ========================================================= */

    @media (max-width: 1000px) {

        .projects-page {
            padding: 6rem 1.5rem 4rem;
        }

        .projects-grid {
            grid-template-columns: 1fr;
        }

        .project-card {
            display: grid;
            grid-template-columns: minmax(280px, 0.9fr) 1.1fr;
        }

        .project-cover {
            height: 100%;
            min-height: 400px;

            border-right: 1px solid rgba(255, 255, 255, 0.1);
            border-bottom: 0;
        }
    }


    /* =========================================================
       PHONE
       ========================================================= */

    @media (max-width: 700px) {

        .projects-page {
            padding: 4rem 1rem 3rem;
        }

        .projects-header {
            margin-bottom: 3rem;
        }

        .projects-header h1 {
            font-size: clamp(3rem, 16vw, 5rem);
        }

        .projects-header p {
            font-size: 0.9rem;
        }

        .projects-grid {
            gap: 1rem;
        }

        .project-card {
            display: block;

            border-radius: 22px;
        }

        .project-cover {
            height: 220px;
            min-height: 0;

            border-right: 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .project-content {
            padding: 1.4rem;
        }

        .project-heading h2 {
            font-size: 1.45rem;
        }

        .project-long {
            font-size: 0.82rem;
        }

        .meta-group {
            flex-direction: column;
            gap: 0.5rem;
        }

        .meta-label {
            width: auto;
        }

        .project-links {
            flex-direction: column;
        }

        .project-link {
            width: 100%;
        }
    }


    /* =========================================================
       REDUCED MOTION
       ========================================================= */

    @media (prefers-reduced-motion: reduce) {

        .project-card,
        .project-cover img,
        .card-glow,
        .project-link,
        .arrow {
            transition: none;
        }

        .project-card:hover {
            transform: none;
        }

        .project-card:hover .project-cover img {
            transform: none;
        }
    }
</style>
