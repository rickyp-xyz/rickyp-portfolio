---
import { site } from "../../config/site";
import MobileMenu from "./MobileMenu";
import "./navbar.css";

const { name } = site;

const navItems = [
  { label: "Projects", to: "/projects" },
  { label: "Publications", to: "/publications" },
  { label: "Blog", to: "/blog" },
  { label: "Tech", to: "/tech" },
  { label: "Now", to: "/now" },
];
---

<nav class="navbar">
  <div class="navbar-inner">
    <a href="/" class="logo" aria-label="Home">
      <span class="logo-mark"></span>
      <span>{name}</span>
    </a>

    <!-- Desktop navigation -->
    <div class="nav-links">
      {navItems.map((item) => (
        <a href={item.to} class="nav-link">
          {item.label}
        </a>
      ))}
    </div>

    <!-- Mobile navigation island -->
    <MobileMenu items={navItems} client:load />
  </div>
</nav>
